# Copy to /etc/garudashield-collector.env on AlmaLinux. Dry-run stays enabled until reviewed.
GARUDASHIELD_API_URL=http://127.0.0.1:8000
GARUDASHIELD_LOG_FILE=/var/log/secure
GARUDASHIELD_STATE_DIR=/var/lib/garudashield-collector
GARUDASHIELD_DRY_RUN=true
GARUDASHIELD_HTTP_TIMEOUT=5
GARUDASHIELD_POLL_SECONDS=1
GARUDASHIELD_IDLE_WARN_SECONDS=300
GARUDASHIELD_LOG_LEVEL=INFO
